# Скопируйте этот файл как bot/.env и впишите ваш токен от @BotFather
TELEGRAM_BOT_TOKEN=1234567890:AAF_your_token_here

# Опционально: ID канала или чата (например -1001234567890) для еженедельного автодайджеста (Пн 10:00 МСК)
# TELEGRAM_DIGEST_CHAT_ID=

# Опционально: настройки монетизации (/pro и лимит бесплатных алертов)
# FREE_ALERTS_LIMIT=3
# PRO_USER_IDS=123456789,987654321
# PRO_CONTACT_URL=https://t.me/ваш_ник
